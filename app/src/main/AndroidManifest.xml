<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ǰ̨����Ȩ�� -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- ֪ͨȨ�� (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ��ȷ���� -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- ����ʶ�� -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- ����Ȩ�� -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Exercise"
        tools:targetApi="36">

        <!-- ���ҳ -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Exercise.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录/注册页 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Exercise" />

        <!-- ��ҳ�� -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Exercise" />

        <!-- �γ�����ҳ -->
        <activity
            android:name=".ui.courses.CourseDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Exercise" />

        <!-- ����ʷҳ -->
        <activity
            android:name=".ui.checkin.CheckInHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Exercise" />

        <!-- ��̨�Ʋ����� -->
        <service
            android:name=".service.StepService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- �˶���ɹ㲥������ -->
        <receiver
            android:name=".receiver.WorkoutReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.exercise.WORKOUT_COMPLETE" />
                <action android:name="com.example.exercise.STEPS_UPDATED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
